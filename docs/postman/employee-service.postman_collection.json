          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is EMPLOYEE_NOT_FOUND', () => pm.expect(pm.response.json().error).to.eql('EMPLOYEE_NOT_FOUND'));"
                ]

# Copy to .env and set every password. .env is ignored by Git.
# Format: KEY=value, no quotes. Double any backslash in the password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=employee_service
DB_USER=employee_app
DB_PASSWORD=
JPA_DDL_AUTO=update

# API users (HTTP Basic). ADMIN can read and write; READER can only read.
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=
API_READER_USER=reader
API_READER_PASSWORD=
